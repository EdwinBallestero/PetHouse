@{
    ViewData["Title"] = "Inicio";
}

<!-- CSS personalizado para efectos visuales -->
<style>
    /* Gradient overlay sobre las imágenes del carrusel para legibilidad */
    .carousel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);
        border-radius: 1rem;
    }

    .hero-carousel .carousel-item {
        height: 520px;
    }

    .hero-carousel img {
        height: 100%;
        object-fit: cover;
    }

    /* Cards interactivos con elevación suave */
    .feature-card {
        transition: transform 0.3s ease, shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.12) !important;
        }
</style>

<div class="container py-4">

    <!-- 1. Hero / Carrusel Principal -->
    <div id="pethouseCarousel" class="carousel slide hero-carousel shadow-lg rounded-4 overflow-hidden mb-5" data-bs-ride="carousel">
        <!-- Indicadores -->
        <div class="carousel-indicators mb-3">
            <button type="button" data-bs-target="#pethouseCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#pethouseCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#pethouseCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <!-- Items del Carrusel -->
        <div class="carousel-inner">

            <!-- Slide 1: Catálogo -->
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?q=80&w=1600&auto=format&fit=crop" class="d-block w-100" alt="Catálogo de Productos">
                <div class="carousel-overlay"></div>
                <div class="carousel-caption d-md-block text-start p-4 p-md-5">
                    <span class="badge bg-warning text-dark mb-2 px-3 py-2 fw-bold uppercase rounded-pill">PetHouse Store</span>
                    <h1 class="display-4 fw-bold text-white mb-2">Todo lo que tu mascota merece</h1>
                    <p class="fs-5 text-light mb-4">Descubre nuestro amplio catálogo de productos de alta calidad, alimentos y accesorios.</p>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow">
                        <i class="bi bi-bag-check me-2"></i>Ver Catálogo
                    </a>
                </div>
            </div>

            <!-- Slide 2: Eventos -->
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?q=80&w=1600&auto=format&fit=crop" class="d-block w-100" alt="Eventos PetHouse">
                <div class="carousel-overlay"></div>
                <div class="carousel-caption d-md-block text-start p-4 p-md-5">
                    <span class="badge bg-info text-white mb-2 px-3 py-2 fw-bold uppercase rounded-pill">Comunidad & Novedades</span>
                    <h1 class="display-4 fw-bold text-white mb-2">Eventos y Actividades Especiales</h1>
                    <p class="fs-5 text-light mb-4">Unete a nuestras jornadas de vacunación, talleres y convivencias para mascotas.</p>
                    <a href="#eventos" class="btn btn-light btn-lg rounded-pill px-4 shadow">
                        <i class="bi bi-calendar-event me-2"></i>Ver Eventos
                    </a>
                </div>
            </div>

            <!-- Slide 3: Reservas -->
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1516734212186-a967f81ad0d7?q=80&w=1600&auto=format&fit=crop" class="d-block w-100" alt="Reservas en línea">
                <div class="carousel-overlay"></div>
                <div class="carousel-caption d-md-block text-start p-4 p-md-5">
                    <span class="badge bg-success text-white mb-2 px-3 py-2 fw-bold uppercase rounded-pill">Servicios Médicos y Estética</span>
                    <h1 class="display-4 fw-bold text-white mb-2">Reserva tu Cita en Línea</h1>
                    <p class="fs-5 text-light mb-4">Agenda consultas veterinarias, baño y peluquería en pocos pasos de forma rápida y segura.</p>
                    <a href="#reservas" class="btn btn-warning btn-lg rounded-pill px-4 shadow fw-bold">
                        <i class="bi bi-clock-history me-2"></i>Agendar Cita
                    </a>
                </div>
            </div>

        </div>

        <!-- Botones Control Prev / Next -->
        <button class="carousel-control-prev" type="button" data-bs-target="#pethouseCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-50 p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#pethouseCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-50 p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>

    <!-- 2. Badges de Beneficios / Valor Añadido -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Calidad Garantizada</h6>
                    <small class="text-muted">Productos certificados para el bienestar de tu mascota.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                    <i class="bi bi-clock-fill fs-2"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Reservas 24/7</h6>
                    <small class="text-muted">Agenda citas cuando quieras sin esperas telefónicas.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center p-3 bg-white border-0 shadow-sm rounded-4">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                    <i class="bi bi-heart-fill fs-2"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Atención Personalizada</h6>
                    <small class="text-muted">Profesionales apasionados por los animales.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Secciones Rápidas / Accesos Directos -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark mb-1">Nuestros Servicios Principales</h2>
        <p class="text-muted">Explora todo lo que tenemos para ofrecerle a tu mejor amigo</p>
    </div>

    <div class="row g-4 mb-5">
        <!-- Servicio 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden feature-card">
                <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Productos" style="height: 200px; object-fit: cover;">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-dark">Catálogo de Productos</h5>
                    <p class="text-muted small">Alimentos premium, juguetes, accesorios y productos de higiene para perros y gatos.</p>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
                        Explorar Productos
                    </a>
                </div>
            </div>
        </div>

        <!-- Servicio 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden feature-card">
                <img src="https://images.unsplash.com/photo-1516734212186-a967f81ad0d7?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Peluquería y Veterinaria" style="height: 200px; object-fit: cover;">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-dark">Estética y Consulta</h5>
                    <p class="text-muted small">Baños, cortes de pelo especializados y revisiones médicas para mantener a tu mascota saludable.</p>
                    <a href="#reservas" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
                        Agendar Cita
                    </a>
                </div>
            </div>
        </div>

        <!-- Servicio 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden feature-card">
                <img src="https://images.unsplash.com/photo-1544568100-847a948585b9?q=80&w=800&auto=format&fit=crop" class="card-img-top" alt="Eventos" style="height: 200px; object-fit: cover;">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-dark">Eventos & Suscripciones</h5>
                    <p class="text-muted small">Mantente al tanto de nuestros talleres, jornadas comunitarias y descuentos de temporada.</p>
                    <a href="#eventos" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
                        Ver Novedades
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script type="text/javascript">
        // Inicialización optimizada del carrusel Bootstrap
        const myCarouselElement = document.getElementById('pethouseCarousel');
        const carousel = new bootstrap.Carousel(myCarouselElement, {
            interval: 4000,
            pause: 'hover',
            wrap: true
        });
    </script>
}