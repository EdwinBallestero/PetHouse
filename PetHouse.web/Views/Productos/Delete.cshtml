@model PetHouse.Application.DTOs.ProductosDTO

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Volver a productos
        </a>
        <h2 class="fw-bold mt-3">Eliminar producto</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                ¿Estás seguro de que deseás eliminar este producto?
                Esta acción puede ser irreversible.
            </div>

            <h4 class="fw-bold">@Model.Nombre</h4>
            <p class="text-muted">
                Código: @Model.ProductoId
            </p>

            <dl class="row">
                <dt class="col-sm-3">Categoría</dt>
                <dd class="col-sm-9">
                    @(Model.NombreCategoria ?? "Sin categoría")
                </dd>

                <dt class="col-sm-3">Marca</dt>
                <dd class="col-sm-9">@(Model.Marca ?? "—")</dd>

                <dt class="col-sm-3">Precio</dt>
                <dd class="col-sm-9">@Model.Precio.ToString("C2")</dd>

                <dt class="col-sm-3">Existencias</dt>
                <dd class="col-sm-9">@Model.Stock</dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.ProductoId"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Confirmar eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
