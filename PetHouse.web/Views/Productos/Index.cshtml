@model IEnumerable<PetHouse.Application.DTOs.ProductosDTO>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Inventario de productos</h2>
            <p class="text-muted mb-0">
                Administrá los productos de PetHouse.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-pethouse">
            <i class="bi bi-plus-lg me-1"></i> Nuevo producto
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @ViewBag.Error
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-3 p-lg-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Marca</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var producto in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@producto.Nombre</div>
                                        <small class="text-muted">
                                            ID: @producto.ProductoId
                                        </small>
                                    </td>
                                    <td>
                                        @(producto.NombreCategoria ?? "Sin categoría")
                                    </td>
                                    <td>@(producto.Marca ?? "—")</td>
                                    <td class="fw-semibold">
                                        @producto.Precio.ToString("C2")
                                    </td>
                                    <td>
                                        @if (producto.Stock <= producto.StockMinimo)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @producto.Stock unidades
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @producto.Stock unidades
                                            </span>
                                        }
                                        <div class="small text-muted">
                                            Mínimo: @producto.StockMinimo
                                        </div>
                                    </td>
                                    <td>
                                        @if (producto.Activo)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details"
                                               asp-route-id="@producto.ProductoId"
                                               class="btn btn-outline-secondary"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@producto.ProductoId"
                                               class="btn btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@producto.ProductoId"
                                               class="btn btn-outline-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                                    <p class="mt-2 mb-1 fw-semibold">
                                        No hay productos registrados
                                    </p>
                                    <p class="text-muted small">
                                        Podés comenzar agregando un producto.
                                    </p>
                                    <a asp-action="Create" class="btn btn-pethouse btn-sm">
                                        Crear producto
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
