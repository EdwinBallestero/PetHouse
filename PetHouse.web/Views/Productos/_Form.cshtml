@model PetHouse.Application.DTOs.ProductosDTO

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<input type="hidden" asp-for="ProductoId" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label">Nombre del producto</label>
        <input asp-for="Nombre" class="form-control"
               placeholder="Ej. Alimento para perro" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoriaProductoId" class="form-label">
            Categoría
        </label>
        <select asp-for="CategoriaProductoId"
                asp-items="ViewBag.Categorias"
                class="form-select" required>
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaProductoId"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Marca" class="form-label">Marca</label>
        <input asp-for="Marca" class="form-control"
               placeholder="Marca del producto" />
    </div>

    <div class="col-md-6">
        <label asp-for="Precio" class="form-label">Precio (₡)</label>
        <input asp-for="Precio" type="number" step="0.01" min="0"
               class="form-control" required />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Stock" class="form-label">Existencias</label>
        <input asp-for="Stock" type="number" min="0"
               class="form-control" required />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="StockMinimo" class="form-label">
            Stock mínimo
        </label>
        <input asp-for="StockMinimo" type="number" min="0"
               class="form-control" required />
        <span asp-validation-for="StockMinimo"
              class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"
                  rows="3" placeholder="Descripción del producto"></textarea>
    </div>

    <div class="col-12">
        <label asp-for="ImagenUrl" class="form-label">
            URL de la imagen
        </label>
        <input asp-for="ImagenUrl" type="url" class="form-control"
               placeholder="https://ejemplo.com/imagen.jpg" />
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="Activo" class="form-check-input"
                   role="switch" />
            <label asp-for="Activo" class="form-check-label">
                Producto activo
            </label>
        </div>
    </div>
</div>
