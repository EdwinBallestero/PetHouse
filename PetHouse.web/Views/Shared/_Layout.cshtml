
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>PetHouse - @ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetHouse.web.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">

            <!-- Menú lateral -->
            <aside class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 navbar-pethouse">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-3 text-white min-vh-100">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="d-flex align-items-center pb-3 mb-3 text-white text-decoration-none">
                        <i class="bi bi-house-heart-fill fs-4 me-2"></i>
                        <span class="fs-5 fw-bold d-none d-sm-inline">PetHouse</span>
                    </a>

                    <hr class="w-100" />

                    <ul class="nav nav-pills flex-column mb-auto align-items-center align-items-sm-start w-100">

                        <!-- Inicio -->
                        <li class="nav-item w-100">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link text-white">
                                <i class="bi bi-house me-2"></i>
                                <span class="d-none d-sm-inline">Inicio</span>
                            </a>
                        </li>

                        <!-- Mantenimientos -->
                        <li class="nav-item w-100 mt-3">
                            <span class="text-uppercase small text-white-50 d-none d-sm-inline">
                                Mantenimientos
                            </span>
                        </li>

                        <li class="nav-item w-100">
                            <a asp-controller="Usuarios"
                               asp-action="Index"
                               class="nav-link text-white">
                                <i class="bi bi-people me-2"></i>
                                <span class="d-none d-sm-inline">Usuarios</span>
                            </a>
                        </li>

                        <li class="nav-item w-100">
                            <a asp-controller="Productos"
                               asp-action="Index"
                               class="nav-link text-white">
                                <i class="bi bi-people me-2"></i>
                                <span class="d-none d-sm-inline">Productos</span>
                            </a>
                        </li>

                        <!-- Procesos -->
                        <li class="nav-item w-100 mt-3">
                            <span class="text-uppercase small text-white-50 d-none d-sm-inline">
                                Procesos
                            </span>
                        </li>

                        <li class="nav-item w-100">
                            <a href="#"
                               class="nav-link text-white"
                               title="Módulo pendiente de implementar">
                                <i class="bi bi-calendar-check me-2"></i>
                                <span class="d-none d-sm-inline">Reservas</span>
                            </a>
                        </li>

                    </ul>

                    <hr class="w-100" />

                    <!-- Usuario y autenticación -->
                    <div class="w-100 pb-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="text-white mb-2 text-break">
                                <i class="bi bi-person-circle me-2"></i>
                                <span class="d-none d-sm-inline">
                                    @User.Identity.Name
                                </span>
                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-outline-light btn-sm w-100">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    <span class="d-none d-sm-inline">Cerrar sesión</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="nav-link text-white">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                <span class="d-none d-sm-inline">Iniciar sesión</span>
                            </a>

                            <a asp-controller="Account"
                               asp-action="Registro"
                               class="nav-link text-white">
                                <i class="bi bi-person-plus me-2"></i>
                                <span class="d-none d-sm-inline">Registrarse</span>
                            </a>
                        }
                    </div>

                </div>
            </aside>

            <!-- Contenido principal -->
            <div class="col py-4 px-3 px-md-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>

                <footer class="border-top mt-4 pt-3 text-muted small">
                    &copy; @DateTime.Now.Year PetHouse
                    <span class="mx-1">|</span>
                    Sistema de gestión
                </footer>
            </div>

        </div>
    </div>

    <!-- Scripts globales: cargarlos una sola vez -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Permite que las vistas agreguen sus propios scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
