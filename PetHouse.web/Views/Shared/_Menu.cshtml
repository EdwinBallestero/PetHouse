
<nav class="navbar navbar-expand-lg navbar-pethouse" data-bs-theme="dark">
    <div class="container-fluid">

        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-heart-fill me-2"></i>
            PetHouse
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal"
                aria-expanded="false"
                aria-label="Mostrar u ocultar menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">

            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="bi bi-house me-1"></i>
                        Inicio
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="menuMantenimientos"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <i class="bi bi-wrench-adjustable me-1"></i>
                        Mantenimientos
                    </a>

                    <ul class="dropdown-menu"
                        aria-labelledby="menuMantenimientos">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Usuarios"
                               asp-action="Index">
                                <i class="bi bi-people me-2"></i>
                                Usuarios
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Productos"
                               asp-action="Index">
                                <i class="bi bi-box-seam me-2"></i>
                                Productos
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="CategoriasProducto"
                               asp-action="Index">
                                <i class="bi bi-tags me-2"></i>
                                Categorías de productos
                            </a>
                        </li>

                    </ul>
                </li>

            </ul>

            <ul class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <span class="nav-link">
                            <i class="bi bi-person-circle me-1"></i>
                            @User.Identity.Name
                        </span>
                    </li>

                    <li class="nav-item">
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit"
                                    class="btn btn-outline-light btn-sm mt-1">
                                <i class="bi bi-box-arrow-right me-1"></i>
                                Cerrar sesión
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Iniciar sesión
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Registro">
                            <i class="bi bi-person-plus me-1"></i>
                            Registrarse
                        </a>
                    </li>
                }
            </ul>

        </div>
    </div>
</nav>
