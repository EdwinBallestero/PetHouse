@model IEnumerable<PetHouse.Application.DTOs.UsuariosDTO>

@{
    ViewData["Title"] = "Mantenimiento de usuarios";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Mantenimiento de usuarios</h2>
            <p class="text-muted mb-0">
                Consulta de los usuarios registrados en PetHouse.
            </p>
        </div>

        <div>
            <span class="badge rounded-pill text-bg-light border px-3 py-2">
                <i class="bi bi-people me-1"></i>
                Total: @(Model?.Count() ?? 0)
            </span>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @ViewBag.Error
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="card card-pethouse">
        <div class="card-header bg-white border-bottom p-3">
            <h5 class="mb-0">
                <i class="bi bi-person-lines-fill me-2"></i>
                Listado de usuarios
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-pethouse">
                        <tr>
                            <th>Código</th>
                            <th>Nombre completo</th>
                            <th>Cédula</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var usuario in Model)
                            {
                                <tr>
                                    <td>@usuario.UsuarioId</td>

                                    <td class="fw-semibold">
                                        @usuario.Nombre @usuario.Apellidos
                                    </td>

                                    <td>@usuario.Cedula</td>
                                    <td>@usuario.Correo</td>
                                    <td>@usuario.Telefono</td>

                                    <td>
                                        @(usuario.RoleNombre ?? usuario.RoleId.ToString())
                                    </td>

                                    <td>
                                        @if (usuario.Activo)
                                        {
                                            <span class="badge rounded-pill text-bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill text-bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@usuario.UsuarioId"
                                           class="btn btn-sm btn-outline-info"
                                           title="Ver detalles">
                                            <i class="bi bi-eye me-1"></i>
                                            Detalles
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                    <span class="text-muted">
                                        No hay usuarios para mostrar.
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
